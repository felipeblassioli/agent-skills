{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cursor Pack Registry",
  "type": "object",
  "required": [
    "packs",
    "targetPaths"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "packs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "version",
          "author",
          "path",
          "targets",
          "profiles",
          "installPolicy",
          "tags",
          "description"
        ],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "project-cursor",
                "user-cursor",
                "project-codex",
                "user-codex"
              ]
            }
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "installPolicy": {
            "type": "object",
            "required": [
              "backupOnConflict",
              "defaultProfile",
              "projectRules",
              "mcp"
            ],
            "properties": {
              "backupOnConflict": {
                "type": "boolean"
              },
              "defaultProfile": {
                "type": "string"
              },
              "projectRules": {
                "type": "string",
                "enum": [
                  "none",
                  "project-only"
                ]
              },
              "mcp": {
                "type": "string",
                "enum": [
                  "none",
                  "example-only"
                ]
              }
            },
            "additionalProperties": true
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "targetPaths": {
      "type": "object",
      "required": [
        "project-cursor",
        "user-cursor",
        "project-codex",
        "user-codex"
      ],
      "properties": {
        "project-cursor": {
          "type": "string",
          "minLength": 1
        },
        "user-cursor": {
          "type": "string",
          "minLength": 1
        },
        "project-codex": {
          "type": "string",
          "minLength": 1
        },
        "user-codex": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
