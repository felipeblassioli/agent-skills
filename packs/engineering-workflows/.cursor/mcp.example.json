{
  "mcpServers": {
    "slack": {
      "type": "http",
      "url": "https://mcp.slack.com/mcp",
      "headers": {
        "Authorization": "Bearer ${env:SLACK_MCP_TOKEN}"
      }
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp",
      "headers": {
        "Authorization": "Bearer ${env:LINEAR_MCP_TOKEN}"
      }
    },
    "asana": {
      "type": "http",
      "url": "https://mcp.asana.com/v2/mcp",
      "headers": {
        "Authorization": "Bearer ${env:ASANA_MCP_TOKEN}"
      }
    },
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "headers": {
        "Authorization": "Bearer ${env:ATLASSIAN_MCP_TOKEN}"
      }
    },
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp",
      "headers": {
        "Authorization": "Bearer ${env:NOTION_MCP_TOKEN}"
      }
    },
    "github": {
      "type": "http",
      "url": "https://api.github.com/mcp",
      "headers": {
        "Authorization": "Bearer ${env:GITHUB_MCP_TOKEN}"
      }
    },
    "pagerduty": {
      "type": "http",
      "url": "https://mcp.pagerduty.com/mcp",
      "headers": {
        "Authorization": "Bearer ${env:PAGERDUTY_MCP_TOKEN}"
      }
    },
    "datadog": {
      "type": "http",
      "url": "https://mcp.datadoghq.com/mcp",
      "headers": {
        "Authorization": "Bearer ${env:DATADOG_MCP_TOKEN}"
      }
    }
  }
}
