{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/block-dangerous-shell.sh",
        "timeout": 10,
        "matcher": "rm -rf|git reset --hard|git clean -fd|git clean -xdf|chmod -R 777"
      }
    ],
    "beforeReadFile": [
      {
        "command": ".cursor/hooks/protect-sensitive-reads.sh",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "type": "prompt",
        "prompt": "Allow this MCP tool only if the action is clearly explained, uses the minimum needed scope, and does not expose secrets. If the request is ambiguous or seems overly broad, deny it. Arguments: $ARGUMENTS",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "subagentStart": [
      {
        "command": ".cursor/hooks/audit-subagent.sh",
        "timeout": 10
      }
    ],
    "subagentStop": [
      {
        "command": ".cursor/hooks/audit-subagent.sh",
        "timeout": 10
      }
    ]
  }
}
