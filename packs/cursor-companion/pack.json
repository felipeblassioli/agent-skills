{
  "$schema": "../../cursor-pack.schema.json",
  "name": "cursor-companion",
  "version": "0.1.3",
  "description": "Cursor runtime bundle with companion subagents, project rules, hook guard-rails, MCP templates, operational guides, and an optional bundled orientation skill.",
  "author": "felipeblassioli",
  "targets": [
    "project-cursor",
    "user-cursor"
  ],
  "profiles": {
    "lite": {
      "description": "Installs reusable subagents, MCP configuration examples, and the bundled orientation skill without active hooks."
    },
    "strict": {
      "description": "Installs the full companion bundle, including hooks, project rules where Cursor supports them, and the bundled orientation skill."
    }
  },
  "artifacts": [
    {
      "id": "agents",
      "source": ".cursor/agents",
      "targets": [
        "project-cursor",
        "user-cursor"
      ],
      "profiles": [
        "lite",
        "strict"
      ],
      "projectPath": ".cursor/agents",
      "userPath": "agents"
    },
    {
      "id": "rules",
      "source": ".cursor/rules",
      "targets": [
        "project-cursor"
      ],
      "profiles": [
        "strict"
      ],
      "projectPath": ".cursor/rules",
      "notes": [
        "User rules are managed in Cursor settings, so filesystem rules are installed only for project targets."
      ]
    },
    {
      "id": "project-hooks-config",
      "source": ".cursor/hooks.project.json",
      "targets": [
        "project-cursor"
      ],
      "profiles": [
        "strict"
      ],
      "projectPath": ".cursor/hooks.json"
    },
    {
      "id": "user-hooks-config",
      "source": ".cursor/hooks.user.json",
      "targets": [
        "user-cursor"
      ],
      "profiles": [
        "strict"
      ],
      "userPath": "hooks.json"
    },
    {
      "id": "hook-scripts",
      "source": ".cursor/hooks",
      "targets": [
        "project-cursor",
        "user-cursor"
      ],
      "profiles": [
        "strict"
      ],
      "projectPath": ".cursor/hooks",
      "userPath": "hooks"
    },
    {
      "id": "mcp-example",
      "source": ".cursor/mcp.example.json",
      "targets": [
        "project-cursor",
        "user-cursor"
      ],
      "profiles": [
        "lite",
        "strict"
      ],
      "projectPath": ".cursor/mcp.example.json",
      "userPath": "mcp.example.json",
      "notes": [
        "The installer never promotes this file to mcp.json automatically."
      ]
    },
    {
      "id": "bundled-skill-pack-overview",
      "kind": "skill",
      "skillId": "cursor-companion-pack-overview",
      "source": "skills/cursor-companion-pack-overview",
      "targets": [
        "project-cursor",
        "user-cursor"
      ],
      "profiles": [
        "lite",
        "strict"
      ],
      "notes": [
        "Installs to .cursor/skills/cursor-companion-pack-overview/ (project) or ~/.cursor/skills/cursor-companion-pack-overview/ (user).",
        "Not listed in skill-registry.json unless promoted to the central registry."
      ]
    }
  ],
  "install": {
    "defaultProfile": "lite",
    "backupOnConflict": true,
    "stageRoot": ".work/cursor-pack-staging",
    "backupRoot": ".work/cursor-pack-backups",
    "manifestFile": ".cursor-pack-manifest.json",
    "conflictPolicy": "backup-and-overwrite",
    "mcpPolicy": "example-only"
  }
}
