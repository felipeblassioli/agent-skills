{
  "$schema": "./cursor-pack-registry.schema.json",
  "packs": {
    "cursor-companion": {
      "version": "0.1.2",
      "author": "felipeblassioli",
      "path": "packs/cursor-companion",
      "targets": [
        "project-cursor",
        "user-cursor"
      ],
      "profiles": [
        "lite",
        "strict"
      ],
      "installPolicy": {
        "backupOnConflict": true,
        "defaultProfile": "lite",
        "projectRules": "project-only",
        "mcp": "example-only"
      },
      "tags": [
        "cursor",
        "subagents",
        "rules",
        "hooks",
        "mcp",
        "guardrails"
      ],
      "description": "Cursor runtime bundle with companion subagents, project rules, hook guard-rails, MCP templates, and operational guides."
    },
    "gcp-log-investigation": {
      "version": "0.1.0",
      "author": "felipeblassioli",
      "path": "packs/gcp-log-investigation",
      "targets": [
        "project-cursor",
        "user-cursor"
      ],
      "profiles": [
        "lite",
        "strict"
      ],
      "installPolicy": {
        "backupOnConflict": true,
        "defaultProfile": "lite",
        "projectRules": "project-only",
        "mcp": "none"
      },
      "tags": [
        "cursor",
        "gcp",
        "logging",
        "observability",
        "subagents",
        "safety"
      ],
      "description": "Portable GCP log-investigation pack with a reusable log-reader subagent and production-safe guidance for Cloud Run, Cloud Functions, and GKE logs."
    },
    "node-test-verifier": {
      "version": "0.2.0",
      "author": "felipeblassioli",
      "path": "packs/node-test-verifier",
      "targets": [
        "project-cursor",
        "user-cursor"
      ],
      "profiles": [
        "lite",
        "strict"
      ],
      "installPolicy": {
        "backupOnConflict": true,
        "defaultProfile": "lite",
        "projectRules": "project-only",
        "mcp": "none"
      },
      "tags": [
        "cursor",
        "testing",
        "jest",
        "node",
        "coverage",
        "subagents"
      ],
      "description": "Portable Node and Jest verifier pack with a reusable subagent for low-noise, pass-fail-first verification with explicit evidence and optional coverage."
    }
  },
  "targetPaths": {
    "project-cursor": ".cursor",
    "user-cursor": "~/.cursor"
  }
}
