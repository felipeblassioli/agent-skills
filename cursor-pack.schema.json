{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cursor Pack",
  "type": "object",
  "required": [
    "name",
    "version",
    "description",
    "author",
    "targets",
    "profiles",
    "artifacts",
    "install"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "project-cursor",
          "user-cursor",
          "project-codex",
          "user-codex"
        ]
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "description"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "description": "Runtime artifact: copy source to projectPath and/or userPath per target.",
            "required": [
              "id",
              "source",
              "targets",
              "profiles"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "targets": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "enum": [
                    "project-cursor",
                    "user-cursor",
                    "project-codex",
                    "user-codex"
                  ]
                }
              },
              "profiles": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "kind": {
                "type": "string",
                "enum": [
                  "runtime"
                ]
              },
              "projectPath": {
                "type": "string"
              },
              "userPath": {
                "type": "string"
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "description": "Bundled skill: copy source directory into Cursor skill discovery paths; destinations are derived from skillId.",
            "required": [
              "id",
              "source",
              "targets",
              "profiles",
              "kind",
              "skillId"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "targets": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "enum": [
                    "project-cursor",
                    "user-cursor",
                    "project-codex",
                    "user-codex"
                  ]
                }
              },
              "profiles": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "kind": {
                "type": "string",
                "const": "skill"
              },
              "skillId": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "install": {
      "type": "object",
      "required": [
        "defaultProfile",
        "backupOnConflict",
        "stageRoot",
        "backupRoot",
        "manifestFile",
        "conflictPolicy",
        "mcpPolicy"
      ],
      "properties": {
        "defaultProfile": {
          "type": "string"
        },
        "backupOnConflict": {
          "type": "boolean"
        },
        "stageRoot": {
          "type": "string"
        },
        "backupRoot": {
          "type": "string"
        },
        "manifestFile": {
          "type": "string"
        },
        "conflictPolicy": {
          "type": "string",
          "enum": [
            "backup-and-overwrite"
          ]
        },
        "mcpPolicy": {
          "type": "string",
          "enum": [
            "none",
            "example-only"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
