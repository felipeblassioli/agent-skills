{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cursor Pack",
  "type": "object",
  "required": [
    "name",
    "version",
    "description",
    "author",
    "targets",
    "profiles",
    "artifacts",
    "install"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "description"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "targets",
          "profiles"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "projectPath": {
            "type": "string"
          },
          "userPath": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "install": {
      "type": "object",
      "required": [
        "defaultProfile",
        "backupOnConflict",
        "stageRoot",
        "backupRoot",
        "manifestFile",
        "conflictPolicy",
        "mcpPolicy"
      ],
      "properties": {
        "defaultProfile": {
          "type": "string"
        },
        "backupOnConflict": {
          "type": "boolean"
        },
        "stageRoot": {
          "type": "string"
        },
        "backupRoot": {
          "type": "string"
        },
        "manifestFile": {
          "type": "string"
        },
        "conflictPolicy": {
          "type": "string"
        },
        "mcpPolicy": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
